{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slimelounge",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "AccountStore" },
      { "name": "ROOMS", "class_name": "RoomStore" }
    ]
  },
  "exports": {
    "AccountStore": { "type": "durable-object", "storage": "sqlite" },
    "RoomStore": { "type": "durable-object", "storage": "sqlite" }
  }
}
